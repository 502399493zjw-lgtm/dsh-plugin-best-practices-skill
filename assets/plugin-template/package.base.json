{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "External DeepSeek Harness plugin {{PLUGIN_ID}}",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm run build && pnpm run verify:package"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "{{CORDIS_VERSION}}"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "{{CORDIS_VERSION}}",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
